@startuml STATI
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #E1F5FE
  BorderColor #01579B
  BackgroundColor<<External>> #FFF9C4
  BorderColor<<External>> #FBC02D
  BackgroundColor<<Error>> #FFCCCC
  BorderColor<<Error>> #FF0000
}

title Architettura Logica delle Fasi dell'Esperimento (v2)

[*] --> INITIAL_STATE

state INITIAL_STATE {
  INITIAL_STATE : Inizio Esperimento
  INITIAL_STATE : Lettura specifica CDR (n. nodi, caratteristiche...)
}

state INFRASTRUCTURE_PROVISIONING {
  INFRASTRUCTURE_PROVISIONING : Creazione macchine virtuali
}

state INSTALLING_DFAAS {
  INSTALLING_DFAAS : Installazione dFaaS Agent, OpenFaaS e HAProxy...
  INSTALLING_DFAAS : Configurazione rete P2P
}

state PROVISIONING_MONITORING {
  PROVISIONING_MONITORING : Installazione stack monitoring(Prometheus, Grafana e MinIO)
}

state READY <<External>> {
  READY : Sistema configurato e pronto
  READY : Configurazione script k6
}

note right of READY
  **INTERVENTO ESTERNO RICHIESTO**
  Il controller rimane in attesa di un input
  dal frontend o di un cambio stato manuale.
end note

state RUNNING <<External>> {
  RUNNING : Esecuzione Job k6
  RUNNING : Monitoraggio metriche real-time
}

state COOLDOWN {
  COOLDOWN : Sincronizzazione dati Prometheus
  COOLDOWN : Estrazione risultati in CSV verso MinIO
}

state CLEANUP {
  CLEANUP : Rimozione VMs
}

state COMPLETED {
  COMPLETED : Esperimento Terminato correttamente
}

' Transizioni basate sullo Switch Case del Controller
INITIAL_STATE --> INFRASTRUCTURE_PROVISIONING : [case ""]
INFRASTRUCTURE_PROVISIONING --> INSTALLING_DFAAS : [case "INFRASTRUCTURE_PROVISIONING"]
INSTALLING_DFAAS --> PROVISIONING_MONITORING : [case "INSTALLING_DFAAS"]
PROVISIONING_MONITORING --> READY : [case "PROVISIONING_MONITORING"]

' Transizioni gestite esternamente (Frontend)
READY --> RUNNING : Input Esterno (Frontend)
RUNNING --> COOLDOWN : Fine Test / Input Esterno

' Ripresa flusso automatico per chiusura
COOLDOWN --> CLEANUP : [case "COOLDOWN"]
CLEANUP --> COMPLETED : [case "CLEANUP"]
COMPLETED --> [*] : [case "COMPLETED"]

' Gestione Errori
state FAILED <<Error>> {
  FAILED : Snapshot log e stato errore
}

INFRASTRUCTURE_PROVISIONING --> FAILED : Errore SSH/K3s
INSTALLING_DFAAS --> FAILED : Errore Helm/P2P
PROVISIONING_MONITORING --> FAILED : Errore DNS/Svc

@enduml