@startuml
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor #E1F5FE
  BorderColor #01579B
  BackgroundColor<<Error>> #FFCCCC
  BorderColor<<Error>> #FF0000
}

title Architettura Logica delle Fasi dell'Esperimento

[*] --> IDLE 

state IDLE{
  IDLE : Attesa creazione Esperimento (Attesa CDR)
}

state PROVISIONING_INFRA {
  CostruzioneFederazione : Costruisco DFaaS Desiderato
  CostruzioneFederazione --> VerificaProvisioning : OK
  VerificaProvisioning : Verifico che tutto sia pronto
}

state PROVISIONING_MONITORING {
  ProvisioningPrometheus : Provisioning Prometheus
  ProvisioningPrometheus --> VerificaProvisioningMonitoring : OK
  ProvisioningGrafana : Provisioning Grafana
  ProvisioningGrafana --> VerificaProvisioningMonitoring : OK
  VerificaProvisioningMonitoring : Verifico che Prometheus e Grafana siano pronti
  
}

state READY {
  PrepMonitoraggio : Aggiorno configurazione Prometheus
  PrepMonitoraggio : su Prometheus (JSON Injection)
  PrepMonitoraggio --> PrepCarico : OK
  PrepCarico : Generazione Script k6 
  PrepCarico : e lancio del Job
}

state RUNNING {
  MonitoraggioJobK6 : Verifica completamento 
  MonitoraggioJobK6 : o fallimento del Job
  LiveObservability : Apertura Dashboard Grafana 
}

state COOLDOWN {
  BufferSync : Attesa sincronizzazione 
  BufferSync : buffer Prometheus (Dati k6)
  BufferSync --> Estrazioni : OK
  Estrazioni : Estrazione dati da Prometheus to CSV e salvati in MinIO
}

state COMPLETED {
  CLEANUP : Pulizia risorse (se richiesto dall'utente)
}

' Transizioni di alto livello
IDLE --> Validazione_file : Esperimento Creato
Validazione_file -->  PROVISIONING_INFRA: File Validato
PROVISIONING_INFRA --> PROVISIONING_MONITORING : Infra Pronta
PROVISIONING_MONITORING --> READY : Piattaforma monitoring Pronta
READY --> RUNNING : Carico Pronto
RUNNING --> COOLDOWN : Fine Test
COOLDOWN --> COMPLETED : Dati Pronti

' Gestione Errore
PROVISIONING_INFRA --> FAILED : Timeout/Errore
PROVISIONING_MONITORING --> FAILED : Timeout/Errore
READY --> FAILED : Errore Config
RUNNING --> FAILED : Crash k6

state FAILED <<Error>> {
  FAILED : Snapshot dell'errore
}

@enduml