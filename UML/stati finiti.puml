@startuml
skinparam backgroundColor #FFFFFF
skinparam state {
  BackgroundColor<<Error>> #FFCCCC
  BorderColor<<Error>> #FF0000
  FontStyle bold
}

title Automa a Stati Finiti - Lifecycle Esperimento DFaaS (v2026)

[*] --> IDLE : Deploy Operatore

state IDLE {
  IDLE : Attesa Risorsa Custom (CR)
}

IDLE --> PROVISIONING : [New Esperimento]

state PROVISIONING {
  PROVISIONING : Verifica Infrastruttura (Prometheus/Grafana)
  PROVISIONING : Setup Federazione Nodi Edge
  PROVISIONING : Cleanup Target Residui
}

PROVISIONING --> READY : [Infrastruttura OK]
PROVISIONING --> FAILED : [Errore Provisioning]

state READY {
  READY : Generazione ConfigMap (k6 script)
  READY : Configurazione Prometheus (Remote Write)
  READY : Creazione Job k6
}

READY --> RUNNING : [Job k6 Created]
READY --> FAILED : [Errore Config]

state RUNNING {
  RUNNING : k6 genera carico
  RUNNING : Polling Status Job (Succeeded/Failed)
  RUNNING : Live Dashboard Open (Grafana)
}

RUNNING --> COOLDOWN : [Job k6 Succeeded]
RUNNING --> FAILED : [Job k6 Failed]

state COOLDOWN {
  COOLDOWN : Attesa scarico buffer metriche (Remote Write)
  COOLDOWN : Definizione intervallo di analisi (Time Range)
}

COOLDOWN --> COMPLETED : [Dati Consistenti]

state COMPLETED {
  COMPLETED : Export Report Finale
  COMPLETED : Notifica Fine Esperimento
}

state CLEANUP {
  CLEANUP : Rimozione Job k6 e ConfigMap effimere
  CLEANUP : Rimozione Target Prometheus dinamici
}

COMPLETED --> CLEANUP : [User Delete o Auto-cleanup]
CLEANUP --> [*]

state FAILED <<Error>> {
  FAILED : Logging Errore
  FAILED : Snapshot Stato Parziale
}

FAILED --> CLEANUP : [Intervento Operatore]

note right of RUNNING
  In questa fase l'operatore
  monitora il completamento 
  del processo k6 nel cluster.
end note

@enduml