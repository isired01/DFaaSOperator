@startuml
title CDR per Infrastruttura -- Class Diagram

skinparam class {
    BackgroundColor<<CRD>> #E1F5FE
    BorderColor #01579B
}

class Esperimento {
    + String name
    + Federazione federazione
    + bool isCleanupRequested
    + Topologia topologia
    + FaseEsperimento fase
    + String message
}

class Federazione {
    + LoadBalancing strategia
    + List<Nodo> nodi
}

class Nodo {
    + String idNodo
    + String indirizzoIP
    + NodeCapacity capacitàNodo
    + List<String> funzioni
}

class Topologia {
    + List<Link> links
}

class Link {
    + String nodoA
    + String nodoB
    + int latenzaMs
}


' Relazioni
Esperimento *-- Topologia
Topologia *-- "many" Link


' Relazioni di composizione (Spec/Status)

FaseEsperimento --> Esperimento 

' Relazioni Spec
Esperimento *-- Federazione

' Relazioni Federazione
Federazione *-- "many" Nodo

enum FaseEsperimento {
  IDLE
  PROVISIONING
  READY
  RUNNING
  COOLDOWN
  COMPLETED
  FAILED
  CLEANUP
}


enum NodeCapacity {
    LOW
    MEDIUM
    HIGH
}

NodeCapacity --> Nodo

@enduml