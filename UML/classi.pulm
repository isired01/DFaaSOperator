@startuml
title CDR per dFaaSOperator -- Class Diagram

' Stili
skinparam class {
    BackgroundColor<<CRD>> #E1F5FE
    BorderColor #01579B
}
skinparam enum {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
}

' Classi Principali (Kubernetes Style)
class Esperimento <<CRD>> {
    + metav1.ObjectMeta metadata
    + ExperimentSpec spec
    + ExperimentStatus status
}

class ExperimentSpec {
    + Federation federation
    + Topology topology
    + bool isCleanupRequested
}

class ExperimentStatus {
    + FaseEsperimento phase
    + String message
    + List<metav1.Condition> conditions
}

' Sotto-strutture Spec
class Federation {
    + List<Node> nodes
}

class Node {
    + String nodeID
    + String ipAddress
    + String username
    + String password
    + String privateKey
    + NodeCapacity capacity
    + BalancingStrategy balancingStrategy
    + List<Function> functions
}

class Function {
    + String name
    + String image
    + int execTimeout
    + int maxInflight
    + int timeoutMs
}

class Topology {
    + List<Link> links
}

class Link {
    + String nodeA
    + String nodeB
    + int latencyMs
}

' Enumerazioni
enum FaseEsperimento {
    IDLE
    PROVISIONING
    READY
    RUNNING
    COOLDOWN
    COMPLETED
    FAILED
    CLEANUP
}

enum NodeCapacity {
    LOW
    MEDIUM
    HIGH
}

enum BalancingStrategy {
    staticstrategy
    nodemarginstrategy
    recalcstrategy
    alllocalstrategy
    rlagentstrategy
}

' Relazioni Gerarchiche
Esperimento *-- ExperimentSpec
Esperimento *-- ExperimentStatus

ExperimentSpec *-- Federation
ExperimentSpec *-- Topology

Federation *-- "many" Node
Node *-- "many" Function
Topology *-- "many" Link

' Relazioni con Enums
ExperimentStatus -- FaseEsperimento
Node -- NodeCapacity
Node -- BalancingStrategy

@enduml