@startuml
title Classi Esperimento DFaaS (Allineato a v1 API Go)

skinparam class {
    BackgroundColor<<CRD>> #E1F5FE
    BorderColor #01579B
}

class Esperimento {
    + String name
    + List<ConfigurazoneMetrica> metriche
    + ConfigurazioneFederazione federazione
    + ProfiloCarico profilo
    + bool isCleanupRequested
}

class EsperimentoStatus {
    + FaseEsperimento fase
    + String message
}

class ConfigurazoneMetrica {
    + String query
    + String commento
}

class ConfigurazioneFederazione {
    + LoadBalancing strategia
    + List<ConfigurazioneNodo> nodi
}

class ConfigurazioneNodo {
    + String idNodo
    + String indirizzoIP
    + NodeCapacity capacitàNodo
    + List<String> funzioni
    + Map<String, Integer> idVicini
}

class ProfiloCarico {
    + String commonHeaders
    + List<Scenario> scenari
}

class Scenario {
    + String nomeScenario
    + String targetNodeID
    + String nomeFunzioneTarget
    + String body
    + String dataPath
    + TipoEsecutore esecutore
    + List<StageK6> stages
    + Integer vuAllocati
    + Integer startTime
}

class StageK6 {
    + String durata
    + Integer targetRps
}

' Relazioni di composizione (Spec/Status)

Esperimento *-- EsperimentoStatus

' Relazioni Spec
Esperimento *-- "many" ConfigurazoneMetrica
Esperimento *-- ConfigurazioneFederazione
Esperimento *-- ProfiloCarico

' Relazioni Federazione
ConfigurazioneFederazione *-- "many" ConfigurazioneNodo

' Relazioni k6
ProfiloCarico *-- "many" Scenario
Scenario *-- "many" StageK6

note bottom of ConfigurazioneNodo
  idVicini mappa IDNodo -> Latenza(ms)
end note

enum FaseEsperimento {
  IDLE
  PROVISIONING
  READY
  RUNNING
  COOLDOWN
  COMPLETED
  FAILED
  CLEANUP
}

EsperimentoStatus--> FaseEsperimento


enum TipoEsecutore {
    CONSTANT_ARRIVAL_RATE
    RAMPING_ARRIVAL_RATE
}

Scenario --> TipoEsecutore

enum NodeCapacity {
    LOW
    MEDIUM
    HIGH
}

NodeCapacity --> ConfigurazioneNodo


@enduml