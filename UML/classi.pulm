@startuml
title CRD per DFaaSOperator -- Class Diagram (v3, two-CRD split)

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #000000
}

<style>
classDiagram {
  .EnvRoot {
    BackgroundColor #A5D6A7
    LineColor #1B5E20
    LineThickness 6
    FontStyle bold
    FontSize 18
  }
  .LTRoot {
    BackgroundColor #CE93D8
    LineColor #4A148C
    LineThickness 6
    FontStyle bold
    FontSize 18
  }
}
</style>

legend top left
  | Colore | Significato |
  | <#A5D6A7> | Environment CRD (radice infra) |
  | <#CE93D8> | LoadTest CRD (radice test) |
  Tutto parte da queste due classi.
endlegend

' =====================================================================
' Environment CRD
' =====================================================================
class Environment <<EnvRoot>> #A5D6A7 ##[bold]1B5E20 {
    + metav1.ObjectMeta metadata
    + EnvironmentSpec spec
    + EnvironmentStatus status
}

class EnvironmentSpec {
    + List<EnvironmentNode> nodes
    + Topology topology
    + S3ConfigRef s3ConfigRef
}

class EnvironmentStatus {
    + EnvironmentPhase phase
    + int64 observedGeneration
    + int64 provisioningGeneration
    + metav1.Time lastHealthCheck
    + List<K6NodeStatus> k6Nodes
    + List<String> dfaasNodes
    + List<metav1.Condition> conditions
}

class EnvironmentNode {
    + String nodeID
    + String ipAddress
    + NodeRole role
    + NodeCapacity capacity
    + String username
    + String password
    + BalancingStrategy balancingStrategy
    + List<Function> functions
}

class S3ConfigRef {
    + String name
}

class K6NodeStatus {
    + String nodeID
    + String ipAddress
    + String kubeconfigSecret
}

' =====================================================================
' LoadTest CRD
' =====================================================================
class LoadTest <<LTRoot>> #CE93D8 ##[bold]4A148C {
    + metav1.ObjectMeta metadata
    + LoadTestSpec spec
    + LoadTestStatus status
}

class LoadTestSpec {
    + String targetEnvironment
    + List<PerNodeLoad> perNodeLoad
    + MetricsExportSpec metricsExport
    + bool suspended
    + metav1.Time startAt
    + bool stop
    + bool syncStart
}

class LoadTestStatus {
    + LoadTestPhase phase
    + metav1.Time startTime
    + metav1.Time endTime
    + List<TestRunRef> testRuns
    + String exporterJob
    + List<metav1.Condition> conditions
}

class PerNodeLoad {
    + String nodeID
    + int vus
    + String duration
    + LocalObjectReference scriptConfigMap
}

class MetricsExportSpec {
    + List<MetricExportEntry> metrics
    + String step
}

class MetricExportEntry {
    + MetricsExportType type
    + String metricName
    + String query
    + String comment
}

class TestRunRef {
    + String nodeID
    + String name
    + String namespace
    + String phase
}

' =====================================================================
' Shared types (api/v1/common_types.go)
' =====================================================================
class Function {
    + String name
    + String image
    + int execTimeout
    + int maxInflight
    + int timeoutMs
    + int32 maxRate
}

class Topology {
    + List<Link> links
}

class Link {
    + String nodeA
    + String nodeB
    + int latencyMs
}

' =====================================================================
' Enums -- phases
' =====================================================================
enum EnvironmentPhase {
    Idle
    ProvisioningVMs
    ProvisioningInfra
    ProvisioningMonitoring
    Ready
    Unreachable
    Failed
}

enum LoadTestPhase {
    Pending
    Running
    Exporting
    Completed
    Failed
    Aborted
}

' =====================================================================
' Enums -- domain
' =====================================================================
enum NodeRole {
    dfaas-worker
    k6-load-generator
}

enum NodeCapacity {
    LOW
    MEDIUM
    HIGH
}

enum BalancingStrategy {
    staticstrategy
    nodemarginstrategy
    recalcstrategy
    alllocalstrategy
    rlagentstrategy
    randomstrategy
}

enum MetricsExportType {
    raw
    custom-promql
}

' =====================================================================
' Enums -- condition vocabularies (P15)
' =====================================================================
enum "EnvConditionType <<Conditions>>" as EnvConditionType {
    Ready
    VMsReady
    DFaaSNodesReady
    K6Ready
    InfrastructureReady
    MonitoringReady
    NodesReachable
}

enum "LTConditionType <<Conditions>>" as LTConditionType {
    Ready
    EnvironmentLinked
    Scheduled
    Queued
    K6Dispatched
    K6Healthy
    MetricsExported
    SyncReady
}

' =====================================================================
' Composition arrows
' =====================================================================
Environment *-- EnvironmentSpec
Environment *-- EnvironmentStatus

EnvironmentSpec *-- "many" EnvironmentNode
EnvironmentSpec *-- Topology
EnvironmentSpec *-- S3ConfigRef
EnvironmentStatus *-- "many" K6NodeStatus

EnvironmentNode *-- "many" Function
Topology *-- "many" Link

LoadTest *-- LoadTestSpec
LoadTest *-- LoadTestStatus

LoadTestSpec *-- "many" PerNodeLoad
LoadTestSpec *-- MetricsExportSpec
LoadTestStatus *-- "many" TestRunRef

MetricsExportSpec *-- "many" MetricExportEntry

' =====================================================================
' Enum associations
' =====================================================================
EnvironmentStatus -- EnvironmentPhase
EnvironmentStatus -- EnvConditionType
EnvironmentNode -- NodeRole
EnvironmentNode -- NodeCapacity
EnvironmentNode -- BalancingStrategy

LoadTestStatus -- LoadTestPhase
LoadTestStatus -- LTConditionType
MetricExportEntry -- MetricsExportType

' =====================================================================
' Cross-CRD soft reference (resolved at reconcile time by name,
' namespace-local; OwnerRef stamped on the first pass after admission,
' for a scheduled test only when it fires; a test that ends before that
' gets none and outlives the Environment).
' =====================================================================
LoadTest ..> Environment : targetEnvironment

@enduml
